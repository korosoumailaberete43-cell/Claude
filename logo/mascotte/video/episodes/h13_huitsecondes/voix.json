{"dur": 25.49, "fps": 30, "segments": [{"id": "hook", "text": "Voilà ce que CivRebar AI fait en huit secondes.", "t0": 1.2, "t1": 4.62, "words": [{"w": "Voilà", "t": 1.2}, {"w": "ce", "t": 1.637}, {"w": "que", "t": 1.855}, {"w": "CivRebar", "t": 2.146}, {"w": "AI", "t": 2.801}, {"w": "fait", "t": 3.019}, {"w": "en", "t": 3.383}, {"w": "huit", "t": 3.602}, {"w": "secondes.", "t": 3.965}]}, {"id": "attente", "text": "Regarde l'écran, ne cligne pas.", "t0": 5.42, "t1": 7.387, "words": [{"w": "Regarde", "t": 5.42}, {"w": "l'écran,", "t": 5.945}, {"w": "ne", "t": 6.469}, {"w": "cligne", "t": 6.666}, {"w": "pas.", "t": 7.125}]}, {"id": "demo", "text": "Les barres filantes. Les chapeaux. Les cadres. Les cotes. Et les repères.", "t0": 8.387, "t1": 13.18, "words": [{"w": "Les", "t": 8.387}, {"w": "barres", "t": 8.665}, {"w": "filantes.", "t": 9.151}, {"w": "Les", "t": 9.776}, {"w": "chapeaux.", "t": 10.054}, {"w": "Les", "t": 10.679}, {"w": "cadres.", "t": 10.957}, {"w": "Les", "t": 11.443}, {"w": "cotes.", "t": 11.721}, {"w": "Et", "t": 12.138}, {"w": "les", "t": 12.346}, {"w": "repères.", "t": 12.624}]}, {"id": "precision", "text": "Tout est à l'échelle, coté, et prêt à imprimer.", "t0": 13.56, "t1": 16.133, "words": [{"w": "Tout", "t": 13.56}, {"w": "est", "t": 13.846}, {"w": "à", "t": 14.074}, {"w": "l'échelle,", "t": 14.189}, {"w": "coté,", "t": 14.761}, {"w": "et", "t": 15.047}, {"w": "prêt", "t": 15.218}, {"w": "à", "t": 15.504}, {"w": "imprimer.", "t": 15.619}]}, {"id": "civrebar", "text": "Et toi, pendant ce temps-là… tu vérifies. C'est ton métier.", "t0": 16.513, "t1": 19.757, "words": [{"w": "Et", "t": 16.513}, {"w": "toi,", "t": 16.673}, {"w": "pendant", "t": 16.886}, {"w": "ce", "t": 17.311}, {"w": "temps-là…", "t": 17.471}, {"w": "tu", "t": 18.215}, {"w": "vérifies.", "t": 18.375}, {"w": "C'est", "t": 18.853}, {"w": "ton", "t": 19.172}, {"w": "métier.", "t": 19.385}]}, {"id": "fin", "text": "Abonne-toi, la démonstration continue.", "t0": 20.137, "t1": 22.508, "