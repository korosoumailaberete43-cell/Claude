{"dur": 28.56, "fps": 30, "segments": [{"id": "hook", "text": "Dans trente secondes, tu sauras pourquoi ce projet existe.", "t0": 1.2, "t1": 4.553, "words": [{"w": "Dans", "t": 1.2}, {"w": "trente", "t": 1.494}, {"w": "secondes,", "t": 1.906}, {"w": "tu", "t": 2.435}, {"w": "sauras", "t": 2.612}, {"w": "pourquoi", "t": 3.023}, {"w": "ce", "t": 3.553}, {"w": "projet", "t": 3.729}, {"w": "existe.", "t": 4.141}]}, {"id": "constat", "text": "Parce qu'en Afrique, on construit vite. Et on ferraille encore à la main.", "t0": 5.253, "t1": 9.383, "words": [{"w": "Parce", "t": 5.253}, {"w": "qu'en", "t": 5.602}, {"w": "Afrique,", "t": 5.951}, {"w": "on", "t": 6.416}, {"w": "construit", "t": 6.591}, {"w": "vite.", "t": 7.172}, {"w": "Et", "t": 7.463}, {"w": "on", "t": 7.638}, {"w": "ferraille", "t": 7.812}, {"w": "encore", "t": 8.394}, {"w": "à", "t": 8.801}, {"w": "la", "t": 8.917}, {"w": "main.", "t": 9.092}]}, {"id": "conséquence", "text": "Des heures perdues. Des erreurs qui partent sur le chantier. Et personne pour les rattraper.", "t0": 9.763, "t1": 15.003, "words": [{"w": "Des", "t": 9.763}, {"w": "heures", "t": 9.996}, {"w": "perdues.", "t": 10.403}, {"w": "Des", "t": 10.869}, {"w": "erreurs", "t": 11.102}, {"w": "qui", "t": 11.568}, {"w": "partent", "t": 11.8}, {"w": "sur", "t": 12.266}, {"w": "le", "t": 12.499}, {"w": "chantier.", "t": 12.674}, {"w": "Et", "t": 13.198}, {"w": "personne", "t": 13.372}, {"w": "pour", "t": 13.896}, {"w": "les", "t": 14.188}, {"w": "rattraper.", "t": 14.421}]}, {"id": "reponse", "text": "Alors on a écrit l'outil qui manquait.", "t0": 15.383, "t1": 17.71, "words": [{"w": "Alors", "t": 15.383}, {"w": "on", "t": 15.75}, {"w": "a", "t": 15.934}, {"w": "écrit", "t": 16.056}, {"w": "l'outil", "t": 16.424}, {"w": "qui", "t": 16.914}, {"w": "manquait.", "t": 17.158}]}, {"id": "civrebar", "text": "CivRebar AI : le ferraillage, directement dans AutoCAD.", "t0": 18.09, "t1": 22.322, "words": [{"w": "CivRebar", "t": 18.09}, {"w": "AI", "t": 18.808},