{"dur": 27.51, "fps": 30, "segments": [{"id": "hook", "text": "Le ferrailleur ne verra jamais ta poutre.", "t0": 1.2, "t1": 3.477, "words": [{"w": "Le", "t": 1.2}, {"w": "ferrailleur", "t": 1.367}, {"w": "ne", "t": 2.033}, {"w": "verra", "t": 2.2}, {"w": "jamais", "t": 2.533}, {"w": "ta", "t": 2.922}, {"w": "poutre.", "t": 3.088}]}, {"id": "suspense", "text": "Il ne verra que ton plan.", "t0": 4.277, "t1": 5.627, "words": [{"w": "Il", "t": 4.277}, {"w": "ne", "t": 4.439}, {"w": "verra", "t": 4.601}, {"w": "que", "t": 4.925}, {"w": "ton", "t": 5.141}, {"w": "plan.", "t": 5.357}]}, {"id": "realite", "text": "Sur le chantier, debout, parfois sous la pluie. Il lit vite.", "t0": 6.007, "t1": 9.641, "words": [{"w": "Sur", "t": 6.007}, {"w": "le", "t": 6.262}, {"w": "chantier,", "t": 6.454}, {"w": "debout,", "t": 7.027}, {"w": "parfois", "t": 7.474}, {"w": "sous", "t": 7.984}, {"w": "la", "t": 8.302}, {"w": "pluie.", "t": 8.494}, {"w": "Il", "t": 8.876}, {"w": "lit", "t": 9.067}, {"w": "vite.", "t": 9.322}]}, {"id": "conseil", "text": "Alors tout ce qui est ambigu sur ton plan sera interprété. Pas vérifié. Interprété.", "t0": 10.021, "t1": 15.31, "words": [{"w": "Alors", "t": 10.021}, {"w": "tout", "t": 10.413}, {"w": "ce", "t": 10.739}, {"w": "qui", "t": 10.935}, {"w": "est", "t": 11.196}, {"w": "ambigu", "t": 11.458}, {"w": "sur", "t": 11.915}, {"w": "ton", "t": 12.176}, {"w": "plan", "t": 12.437}, {"w": "sera", "t": 12.763}, {"w": "interprété.", "t": 13.09}, {"w": "Pas", "t": 13.808}, {"w": "vérifié.", "t": 14.069}, {"w": "Interprété.", "t": 14.591}]}, {"id": "civrebar", "text": "CivRebar AI dessine toujours selon les mêmes conventions. Un plan, une lecture.", "t0": 15.69, "t1": 21.392, "words": [{"w": "CivRebar", "t": 15.69}, {"w": "AI", "t": 16.356}, {"w": "dessine", "t": 16.578}, {"w": "toujours", "t": 17.171}, {"w": "selon", "t": 17.837}, {"w": "les", "t": 18.281}, {"w": "mêmes", "t": 18.578}, {"w": "conventions.", "t": 19.022}, {"w": "Un", "t": 19.911}, {"w": "plan