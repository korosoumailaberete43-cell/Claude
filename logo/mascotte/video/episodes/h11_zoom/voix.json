{"dur": 26.87, "fps": 30, "segments": [{"id": "hook", "text": "Regarde bien cette barre.", "t0": 1.2, "t1": 3.046, "words": [{"w": "Regarde", "t": 1.2}, {"w": "bien", "t": 1.791}, {"w": "cette", "t": 2.16}, {"w": "barre.", "t": 2.603}]}, {"id": "zoom", "text": "Encore. Plus près.", "t0": 3.746, "t1": 5.149, "words": [{"w": "Encore.", "t": 3.746}, {"w": "Plus", "t": 4.324}, {"w": "près.", "t": 4.736}]}, {"id": "detail", "text": "Son crochet est trop court. Deux centimètres de moins que l'ancrage demandé.", "t0": 6.249, "t1": 10.925, "words": [{"w": "Son", "t": 6.249}, {"w": "crochet", "t": 6.498}, {"w": "est", "t": 6.997}, {"w": "trop", "t": 7.246}, {"w": "court.", "t": 7.558}, {"w": "Deux", "t": 7.932}, {"w": "centimètres", "t": 8.244}, {"w": "de", "t": 8.992}, {"w": "moins", "t": 9.179}, {"w": "que", "t": 9.553}, {"w": "l'ancrage", "t": 9.803}, {"w": "demandé.", "t": 10.426}]}, {"id": "consequence", "text": "Sur le papier, personne ne le voit. Sous charge, la barre glisse.", "t0": 11.305, "t1": 15.493, "words": [{"w": "Sur", "t": 11.305}, {"w": "le", "t": 11.575}, {"w": "papier,", "t": 11.778}, {"w": "personne", "t": 12.251}, {"w": "ne", "t": 12.858}, {"w": "le", "t": 13.061}, {"w": "voit.", "t": 13.264}, {"w": "Sous", "t": 13.601}, {"w": "charge,", "t": 13.939}, {"w": "la", "t": 14.412}, {"w": "barre", "t": 14.615}, {"w": "glisse.", "t": 15.02}]}, {"id": "civrebar", "text": "CivRebar AI dessine les ancrages à la bonne longueur. À chaque fois.", "t0": 15.873, "t1": 20.878, "words": [{"w": "CivRebar", "t": 15.873}, {"w": "AI", "t": 16.545}, {"w": "dessine", "t": 16.769}, {"w": "les", "t": 17.367}, {"w": "ancrages", "t": 17.666}, {"w": "à", "t": 18.338}, {"w": "la", "t": 18.488}, {"w": "bonne", "t": 18.712}, {"w": "longueur.", "t": 19.16}, {"w": "À", "t": 19.832}, {"w": "chaque", "t": 19.982}, {"w": "fois.", "t": 20.505}]}, {"id": "fin", "text": "Abonne-toi, on regarde les détails ensemble.", "t0": 21.258, "t1": 23.886, "words": [{"w": "Abonne-toi,", "t": 21.258}, {"