{"dur": 27.2, "fps": 30, "segments": [{"id": "hook", "text": "Une poutre. Deux méthodes. Un chronomètre.", "t0": 1.2, "t1": 4.257, "words": [{"w": "Une", "t": 1.2}, {"w": "poutre.", "t": 1.506}, {"w": "Deux", "t": 2.041}, {"w": "méthodes.", "t": 2.423}, {"w": "Un", "t": 3.111}, {"w": "chronomètre.", "t": 3.34}]}, {"id": "defi", "text": "À ta montre : combien de temps pour la ferrailler ?", "t0": 4.637, "t1": 7.184, "words": [{"w": "À", "t": 4.637}, {"w": "ta", "t": 4.739}, {"w": "montre", "t": 4.892}, {"w": ":", "t": 5.248}, {"w": "combien", "t": 5.299}, {"w": "de", "t": 5.707}, {"w": "temps", "t": 5.86}, {"w": "pour", "t": 6.165}, {"w": "la", "t": 6.42}, {"w": "ferrailler", "t": 6.573}, {"w": "?", "t": 7.133}]}, {"id": "main", "text": "À la main : le coffrage, les barres, les cadres, les cotes, les repères… quarante minutes.", "t0": 7.984, "t1": 13.285, "words": [{"w": "À", "t": 7.984}, {"w": "la", "t": 8.102}, {"w": "main", "t": 8.278}, {"w": ":", "t": 8.573}, {"w": "le", "t": 8.632}, {"w": "coffrage,", "t": 8.809}, {"w": "les", "t": 9.339}, {"w": "barres,", "t": 9.574}, {"w": "les", "t": 9.987}, {"w": "cadres,", "t": 10.222}, {"w": "les", "t": 10.635}, {"w": "cotes,", "t": 10.87}, {"w": "les", "t": 11.224}, {"w": "repères…", "t": 11.459}, {"w": "quarante", "t": 12.284}, {"w": "minutes.", "t": 12.814}]}, {"id": "auto", "text": "Avec CivRebar : tu donnes la section, la portée, les armatures.", "t0": 13.665, "t1": 17.95, "words": [{"w": "Avec", "t": 13.665}, {"w": "CivRebar", "t": 14.023}, {"w": ":", "t": 14.665}, {"w": "tu", "t": 14.737}, {"w": "donnes", "t": 14.951}, {"w": "la", "t": 15.451}, {"w": "section,", "t": 15.665}, {"w": "la", "t": 16.236}, {"w": "portée,", "t": 16.451}, {"w": "les", "t": 16.951}, {"w": "armatures.", "t": 17.236}]}, {"id": "civrebar", "text": "Huit secondes. Et le plan est dessiné dans AutoCAD.", "t0": 18.33, "t1": 21.532, "words": [{"w": "Huit", "t": 18.33}, {"w": "secondes.", "t": 18.651}, {"w": "Et", "t": 19.227}, {"w": "le", "t": 19.4