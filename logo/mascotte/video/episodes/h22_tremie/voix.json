{"dur": 26.07, "fps": 30, "segments": [{"id": "hook", "text": "Ils ont percé la dalle après coup.", "t0": 1.2, "t1": 2.979, "words": [{"w": "Ils", "t": 1.2}, {"w": "ont", "t": 1.409}, {"w": "percé", "t": 1.618}, {"w": "la", "t": 1.932}, {"w": "dalle", "t": 2.089}, {"w": "après", "t": 2.403}, {"w": "coup.", "t": 2.717}]}, {"id": "suspense", "text": "Et personne n'a renforcé le trou.", "t0": 3.779, "t1": 5.686, "words": [{"w": "Et", "t": 3.779}, {"w": "personne", "t": 3.952}, {"w": "n'a", "t": 4.472}, {"w": "renforcé", "t": 4.703}, {"w": "le", "t": 5.223}, {"w": "trou.", "t": 5.397}]}, {"id": "probleme", "text": "Une trémie coupe des barres. Et une barre coupée ne porte plus rien.", "t0": 6.066, "t1": 10.327, "words": [{"w": "Une", "t": 6.066}, {"w": "trémie", "t": 6.32}, {"w": "coupe", "t": 6.765}, {"w": "des", "t": 7.147}, {"w": "barres.", "t": 7.401}, {"w": "Et", "t": 7.846}, {"w": "une", "t": 8.037}, {"w": "barre", "t": 8.292}, {"w": "coupée", "t": 8.673}, {"w": "ne", "t": 9.118}, {"w": "porte", "t": 9.309}, {"w": "plus", "t": 9.691}, {"w": "rien.", "t": 10.009}]}, {"id": "regle", "text": "Il faut un chevêtre sur les quatre côtés, et des barres en diagonale dans les angles.", "t0": 10.707, "t1": 15.438, "words": [{"w": "Il", "t": 10.707}, {"w": "faut", "t": 10.876}, {"w": "un", "t": 11.157}, {"w": "chevêtre", "t": 11.326}, {"w": "sur", "t": 11.833}, {"w": "les", "t": 12.058}, {"w": "quatre", "t": 12.284}, {"w": "côtés,", "t": 12.678}, {"w": "et", "t": 13.016}, {"w": "des", "t": 13.185}, {"w": "barres", "t": 13.41}, {"w": "en", "t": 13.804}, {"w": "diagonale", "t": 13.973}, {"w": "dans", "t": 14.537}, {"w": "les", "t": 14.818}, {"w": "angles.", "t": 15.044}]}, {"id": "civrebar", "text": "CivRebar AI dessinera les renforts de trémie avec la dalle.", "t0": 15.818, "t1": 20.107, "words": [{"w": "CivRebar", "t": 15.818}, {"w": "AI", "t": 16.472}, {"w": "dessinera", "t": 16.69}, {"w": "les", "t": 17.417}, {"w": "renforts", "t": 17.708}, {"w": "de", "t": 18.362}, {"w": "